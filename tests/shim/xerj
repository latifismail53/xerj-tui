#!/usr/bin/env bash
# Fake `xerj` for integration tests.
# Mimics the behavior core relies on, WITHOUT installing real XERJ.
set -u
case "${1:-}" in
  --version)
    # Exact format as the real one: "xerj v<version>"
    echo "xerj v9.9.9-test"
    ;;
  --insecure)
    # Pretends to be a server: process stays alive so the PID is valid.
    exec sleep 600
    ;;
  autoindex)
    echo "xerj-done ok=true exit=0 reason=completed wall=0.1s files=1 records=2 datasets=1"
    ;;
  init)
    echo "init OK: .mcp.json + skill written"
    touch .mcp.json
    ;;
  search)
    echo "search results for: $2"
    echo "src/a.php:1 matching code snippet..."
    ;;
  def)
    echo "definition $2 -> src/a.php:1 (function $2)"
    ;;
  gain)
    echo "gain: 3 searches, hit rate 100%"
    ;;
  feedback)
    echo "field report draft (dry-run): nothing sent"
    ;;
  *)
    echo "shim: unknown command: ${1:-<empty>}" >&2
    exit 1
    ;;
esac
